# Virtual environments
venv/
.venv/
env/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# macOS system files
.DS_Store
**/.DS_Store

# Model weights & Ultralytics runs
models/*.pt
runs/
*.onnx
*.engine

# Raw videos & generated outputs (privacy & repo size protection)
data/raw_videos/*.mp4
data/raw_videos/*.mov
data/raw_videos/*.avi
data/raw_videos/*.mkv
data/fine_tune_pose/
outputs/videos/*
outputs/telemetry/*
outputs/plots/*
outputs/reports/*

# Keep directory placeholders
!models/.gitkeep
!data/raw_videos/.gitkeep
!outputs/videos/.gitkeep
!outputs/telemetry/.gitkeep
!outputs/plots/.gitkeep
!outputs/reports/.gitkeep
